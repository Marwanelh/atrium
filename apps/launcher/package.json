{
  "name": "@atrium/launcher",
  "version": "1.0.0",
  "description": "Atrium embeddable chat widget",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/atrium.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.lib.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "deploy": "pnpm run build && node deploy-to-silo.js",
    "deploy:prod": "NODE_ENV=production pnpm run deploy"
  },
  "dependencies": {
    "minio": "^8.0.7",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21"
  },
  "license": "MIT",
  "private": true
}
