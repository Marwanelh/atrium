{
  "name": "@atrium/gateway",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "nodemon",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "seed:email-templates": "ts-node -r tsconfig-paths/register src/scripts/seeds/email-templates.seed.ts",
    "migrate:companies": "ts-node -r tsconfig-paths/register src/scripts/migrate-companies.ts",
    "test:ee-missing": "ts-node -r tsconfig-paths/register src/scripts/ee-missing-smoke.ts"
  },
  "keywords": [
    "chat",
    "support",
    "realtime",
    "socket.io"
  ],
  "author": "",
  "license": "MIT",
  "description": "Real-time chat support application backend",
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1162.0",
    "@composio/core": "0.14.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dodopayments": "^2.61.1",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.9",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.14.2",
    "minio": "^8.0.7",
    "mongoose": "^8.24.8",
    "multer": "1.4.5-lts.2",
    "redis": "^4.7.1",
    "sns-validator": "^0.3.5",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.19.2",
    "@types/sns-validator": "^0.3.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^4.1.12",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "private": true
}
