{
  "name": "@atrium/agent",
  "version": "1.0.0",
  "description": "Atrium AI processing service — BullMQ worker + Redis Streams",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "reset:vectors": "npx tsx scripts/reset-vector-db.ts",
    "inspect:vectors": "npx tsx scripts/inspect-vector-db.ts",
    "debug:qdrant": "npx tsx src/debug-qdrant.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1162.0",
    "@google/genai": "^0.7.0",
    "@huggingface/inference": "^4.13.32",
    "@qdrant/js-client-rest": "^1.20.0",
    "axios": "^1.21.0",
    "bullmq": "^5.81.5",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.1",
    "mammoth": "^1.13.0",
    "minio": "^8.0.7",
    "openai": "^4.104.0",
    "p-limit": "^7.3.3",
    "pdf-parse": "^1.1.4",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.19.43",
    "@types/pdf-parse": "^1.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "private": true
}
