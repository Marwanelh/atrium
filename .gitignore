# GSD planning artefacts — local working state, not part of the product.
.planning/

# Build caches and incremental state
*.tsbuildinfo
.eslintcache
.turbo/
dist/
build/

# Logs — never ship runtime output
*.log
logs/

# Editors and OS
.idea/
*.swp
*.swo
Thumbs.db

# Agent runtimes — local tooling state, not part of the product
.claude/
.agents/

# Local scratch
tmp/
*.local

# Generated by scripts/install.sh with a password the deployer chooses.
docker/users.yml
